{
  "name": "@otolab/react-ink-textarea",
  "version": "0.4.1-otolab.0",
  "description": "A multiline textarea component for Ink (otolab fork with IME cursor sync)",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "pnpm run build",
    "dev": "tsc --watch --preserveWatchOutput",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ink",
    "react",
    "cli",
    "textarea",
    "input",
    "terminal",
    "ime",
    "cjk"
  ],
  "author": {
    "name": "Omran Jamal",
    "email": "omran@omranjamal.me",
    "url": "https://omranjamal.me"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otolab/react-ink-textarea.git"
  },
  "bugs": {
    "url": "https://github.com/otolab/react-ink-textarea/issues"
  },
  "homepage": "https://github.com/otolab/react-ink-textarea#readme",
  "peerDependencies": {
    "ink": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "ink": "^7.0.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ansi-styles": "^6.2.3",
    "string-width": "^8.2.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
